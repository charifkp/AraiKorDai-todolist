C4Component
    title Component diagram for ICT To Do List - API Application

    Container_Ext(web_app, "Web Application", "JavaScript, React", "Provides web-based interface")
    Container_Ext(mobile_app, "Mobile Application", "React Native", "Provides mobile interface")
    ContainerDb(db, "Database", "SQLite", "Stores application data")
    System_Ext(mycourses, "MyCourses", "External e-learning system")

    Container_Boundary(api, "API Application") {
        Component(task_controller, "Task Controller", "Flask Blueprint", "Handles HTTP requests for task CRUD operations")
        Component(user_controller, "User Controller", "Flask Blueprint", "Manages user authentication and profile operations")
        Component(sync_controller, "Sync Controller", "Flask Blueprint", "Provides endpoints for triggering and monitoring sync")
        Component(task_service, "Task Service", "Python Class", "Contains business logic for task management")
        Component(user_service, "User Service", "Python Class", "Handles user-related business logic")
        Component(sync_service, "Sync Service", "Python Class", "Manages synchronization with MyCourses")
        Component(db_layer, "Database Layer", "SQLAlchemy", "Provides data access and ORM functionality")
    }
    
    Rel(web_app, task_controller, "Makes requests to", "JSON/HTTPS")
    Rel(web_app, user_controller, "Makes requests to", "JSON/HTTPS")
    Rel(web_app, sync_controller, "Makes requests to", "JSON/HTTPS")

    Rel(mobile_app, task_controller, "Makes requests to", "JSON/HTTPS")
    Rel(mobile_app, user_controller, "Makes requests to", "JSON/HTTPS")
    Rel(mobile_app, sync_controller, "Makes requests to", "JSON/HTTPS")

    Rel(task_controller, task_service, "Uses")
    Rel(user_controller, user_service, "Uses")
    Rel(sync_controller, sync_service, "Uses")

    Rel(task_service, db_layer, "Uses")
    Rel(user_service, db_layer, "Uses")
    Rel(sync_service, db_layer, "Uses")

    Rel(sync_service, mycourses, "Retrieves data from", "HTTPS/JSON")

    Rel(db_layer, db, "Reads from and writes to", "SQL")