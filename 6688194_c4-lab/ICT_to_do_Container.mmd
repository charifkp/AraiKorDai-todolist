C4Container
    title Container diagram for ICT To Do List

    Person(student, "Student", "The main user who manages the task list, views assignments, and tracks submission status.")
    Person(instructor, "Instructor", "May use the system to view their own teaching related tasks and monitor a high level view of assignment deadlines for the courses they teach, but the instructor does not see student private tasks.")
    Person(admin, "System Administrator", "Manages system configuration, supports user accounts, and monitors sync health.")

    System_Ext(mycourses, "MyCourses", "An external ICT e learning system that owns course, assignment, and submission data.")

    Container_Boundary(ict_todo, "ICT To Do List") {
        Container(web_app, "Web Application", "JavaScript, React", "Provides web-based interface for task management and assignment tracking.")
        Container(mobile_app, "Mobile Application", "React Native", "Provides mobile interface for task management on iOS and Android devices.")
        Container(api, "API Application", "Python, Flask", "Provides REST API for task operations, user management, and sync functionality.")
        ContainerDb(db, "Database", "SQLite", "Stores user data, tasks, assignments, and sync status.")
        Container(sync_service, "Sync Service", "Python", "Handles background synchronization of assignments and submission status with MyCourses.")
    }

    Rel(student, web_app, "Uses", "HTTPS")
    Rel(student, mobile_app, "Uses")
    Rel(instructor, web_app, "Uses", "HTTPS")
    Rel(instructor, mobile_app, "Uses")
    Rel(admin, web_app, "Uses", "HTTPS")

    Rel(web_app, api, "Makes API calls", "JSON/HTTPS")
    Rel(mobile_app, api, "Makes API calls", "JSON/HTTPS")
    Rel(api, db, "Reads from and writes to", "SQL")
    Rel(sync_service, mycourses, "Retrieves assignment lists and submission status", "HTTPS/JSON")
    Rel(sync_service, db, "Updates sync data", "SQL")
    Rel(api, sync_service, "Triggers sync operations")